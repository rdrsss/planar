#!/usr/bin/env python3
"""Fake docker for scripts/release-publish.test.py: records every call in $FAKE_LOG.

build --target dist   writes a fake Linux bundle to the --output dest (make linux-dist).
build (other target)  succeeds unless FAKE_TOOLCHAIN_BUILD_EXIT is set.
run ... release-smoke.sh  runs the real smoke script on the host with the -v
                      mounts mapped back to host paths and a bare environment.
run ... client.sh     the TLS client of scripts/test-portable-tls.py: fails for the
                      modes listed in FAKE_CA_FAIL (debian, removed, redhat).
logs                  prints the server's unknown-CA rejection unless FAKE_CA_NO_REJECTION.
"""
import json
import os
import pathlib
import subprocess
import sys

args = sys.argv[1:]
with open(os.environ['FAKE_LOG'], 'a') as log:
    log.write('docker ' + json.dumps(args) + '\n')
tools = pathlib.Path(__file__).resolve().parent
if args[0] == 'build':
    target = args[args.index('--target') + 1] if '--target' in args else ''
    if target != 'dist':
        sys.exit(int(os.environ.get('FAKE_TOOLCHAIN_BUILD_EXIT', '0')))
    dest = next(a for a in args if a.startswith('type=local,dest=')).split('dest=', 1)[1]
    build = dict(args[i + 1].split('=', 1) for i, a in enumerate(args) if a == '--build-arg')
    sys.exit(subprocess.call([sys.executable, str(tools / 'make-bundle.py'), dest, 'linux-x86_64',
                              build['PLANAR_RELEASE_VERSION'] or 'dev', build['PLANAR_SOURCE_SHA'],
                              'scripts/get-planar.sh']))
if args[0] == 'run':
    i, mounts = 1, {}
    while args[i].startswith('-'):
        if args[i] in ('--rm', '-d'):
            i += 1
            continue
        if args[i] == '-v':
            host, container = args[i + 1].split(':')[:2]
            mounts[container] = host
        i += 2
    command = args[i + 1:]
    if '/opt/planar-gates/release-smoke.sh' in command:
        command = [mounts.get(word, word) for word in command]
        sys.exit(subprocess.call(command, env=dict(PATH='/usr/bin:/bin:/usr/sbin:/sbin',
                                                   TMPDIR=os.environ.get('TMPDIR', '/tmp'))))
    if '/fixture/client.sh' in command:
        mode = ('redhat' if '/etc/pki/tls/certs/ca-bundle.crt' in mounts else
                'removed' if command[-1] == 'untrusted' else 'debian')
        print(f'fixture client mode={mode}')
        sys.exit(1 if mode in os.environ.get('FAKE_CA_FAIL', '').split(',') else 0)
    if '-d' in args:
        print('fixture-server-id')
    sys.exit(0)
if args[0] == 'logs':
    if not os.environ.get('FAKE_CA_NO_REJECTION'):
        print('TLS_HANDSHAKE_REJECTION=TLSV1_ALERT_UNKNOWN_CA')
    sys.exit(0)
sys.exit(0)
