#!/usr/bin/env bash
# Planar docs pre-commit hook (plan 423: tabularium).
#
# Verifies that Tabularium's machine-local state is current and that the docs and
# workbench linters pass before allowing a commit. Opt in via:
#
#   ln -s ../../scripts/git-hooks/pre-commit-docs .git/hooks/pre-commit
#
# Documented in docs/workflows.md § Recipe 10 "Doc hygiene pre-commit".

status=0

tabularium verify || {
  echo "Tabularium's machine-local state is out of date — run \`tabularium build\` after" >&2
  echo "reviewing \`tabularium diff\`" >&2
  status=1
}

tabularium lint || {
  echo "tabularium lint failed — fix issues above" >&2
  status=1
}

planar workbench lint --all || {
  echo "planar workbench lint failed — fix frontmatter issues above" >&2
  status=1
}

exit "$status"
