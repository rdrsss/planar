# ============================================================================
# Zig build artifacts
# ============================================================================

# `zig build` install prefix (binary lands at zig-out/bin/planar).
zig-out/

# zig fetch extraction side-effect: zig extracts the content-addressed
# archive into a `zig-pkg/<hash>/` directory in the build root.
zig-pkg/

# Incremental compile cache (current name + legacy name; both can appear
# depending on the zig version operators run).
.zig-cache/
zig-cache/

# C object files produced from the vendored SQLite amalgamation if anyone
# invokes the C compiler directly outside the zig build graph. The graph
# itself keeps these inside .zig-cache/, so this is just a safety net.
*.o
*.obj
*.a
*.lib

# ============================================================================
# Repo-local install destinations
# ============================================================================

# `make build` writes the production binary here from zig-out/bin/.
/bin/

# Workspace-local install destinations for vendor harnesses. Source files
# live under commands/, skills/, copilot/, agents/. These directories hold
# symlinks (or copies) populated by install.sh.
.claude/
.codex/
.copilot/

# ============================================================================
# Database + scratch data
# ============================================================================

# Local SQLite databases, if any (including WAL + shm sidecars).
*.db
*.db-journal
*.db-wal
*.db-shm

# ============================================================================
# Editor / OS clutter
# ============================================================================

.DS_Store
*.swp
*.swo
.idea/
.vscode/

# ============================================================================
# CMake (C++26 rewrite, plan 996)
# ============================================================================

# Out-of-source CMake build trees (CMakePresets.json: build/<preset>).
/build/

# clangd convenience symlink, recreated by CMakeLists.txt on every configure
# — always points at whichever build/<preset> tree was configured most
# recently.
/compile_commands.json

# Doxyfile.lint's OUTPUT_DIRECTORY.
/doxygen-lint-output/

# ============================================================================
# Worktrees
# ============================================================================

# Local git worktrees for feature branches.
.worktrees/

# Parity gap reports — the audit is retired (task 5623); these patterns
# remain so any stale locally-generated report stays untracked.
# Previously regenerated on every `make parity-check` /
# `make test-all` run with fresh timestamp + live in-flight task
# count from the operator's local Planar DB. The hand-curated
# companion at scripts/parity-data/parity-triage.md stays tracked.
scripts/parity-data/parity-gap-report.json
scripts/parity-data/parity-gap-report.md

# Per-vendor skill renders — generated at install time by
# `planar skills render`. Source is skills/src/. See CLAUDE.md
# § Integration test methodology for the render-at-install
# pipeline.
/commands/
/skills/codex/
/skills/copilot/
/skills/gemini/

# Per-vendor agent renders — generated at install time by
# `planar skills render`. Source is agents/*.md role specs.
# The non-rendered source files (agents/coder.md, etc.) are
# checked in; only the vendor subdirs are generated output.
/agents/claude/
/agents/codex/
/agents/copilot/
/agents/gemini/
__pycache__/

# Mt-KaHyPar's own upstream CMakeLists.txt (mt-kahypar/io/CMakeLists.txt)
# writes its version header via `configure_file(... "${CMAKE_CURRENT_SOURCE_DIR}/version.h" ...)`
# -- an in-source write into the vendored tree at configure time (task 6461).
# Content is deterministic (fixed project version, no timestamps), so it is
# not load-bearing for the vendored pin and would otherwise show as an
# untracked file after every configure with PLANAR_WITH_MTKAHYPAR=ON.
/vendor/mtkahypar/*/mt-kahypar/io/version.h
