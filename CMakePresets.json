{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "displayName": "Base (pinned LLVM)",
      "description": "Shared settings: the pinned LLVM (discovered, override with -DPLANAR_LLVM_PREFIX), Ninja, compile_commands.json, out-of-source build. See docs/toolchain-parity.md.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/llvm-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "description": "Unoptimized build with debug info and warnings-as-errors",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PLANAR_WARNINGS_AS_ERRORS": "ON",
        "PLANAR_TEST_BINARY": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "description": "Optimized build with debug info",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "dist",
      "inherits": "release",
      "displayName": "Distribution",
      "description": "Portable release bundle build with static C++ runtime and version metadata; override PLANAR_RELEASE_VERSION for a tagged cut.",
      "cacheVariables": {
        "PLANAR_PORTABLE": "ON",
        "PLANAR_VERSION_META": "ON",
        "PLANAR_RELEASE_VERSION": "$penv{PLANAR_RELEASE_VERSION}",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "dist",
      "configurePreset": "dist"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dist",
      "configurePreset": "dist",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
