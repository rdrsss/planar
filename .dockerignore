# Docker build context for docker/linux-gate.Dockerfile. The context is the
# repo root; keep it to tracked-source size. external/ (first-party sources,
# never committed) is never sent.
.git
build
bin
external
compile_commands.json
doxygen-lint-output
.claude
.codex
.copilot
**/.DS_Store

