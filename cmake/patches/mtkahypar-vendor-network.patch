+# --- Planar vendoring note (task 6459) --------------------------------------
+# Upstream unconditionally FetchContent's CLI11, kahypar-shared-resources and
+# WHFC here, reaching the network on every configure. CLAUDE.md's vendoring
+# rule forbids that shape at the application level, so Planar's own
+# cmake/dependencies.cmake pins each of these as its own CPMAddPackage(...)
+# block (release/tag archives, committed under vendor/) BEFORE this
+# add_subdirectory() runs, and passes their extracted source directories in
+# via PLANAR_CLI11_TARGET / PLANAR_KAHYPAR_SHARED_RESOURCES_DIR /
+# PLANAR_WHFC_DIR. This block consumes those instead of fetching its own
+# copies -- no GIT_REPOSITORY, no network, at configure time.
+if(NOT PLANAR_KAHYPAR_SHARED_RESOURCES_DIR OR NOT PLANAR_WHFC_DIR)
+  message(FATAL_ERROR "Planar vendoring: PLANAR_KAHYPAR_SHARED_RESOURCES_DIR and PLANAR_WHFC_DIR must be set by the parent project (see cmake/dependencies.cmake).")
+endif()
+target_link_libraries(MtKaHyPar-Include INTERFACE ${PLANAR_CLI11_TARGET})
+
+file(MAKE_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/external_tools)
+if(NOT EXISTS ${CMAKE_CURRENT_BINARY_DIR}/external_tools/kahypar-shared-resources)
+  file(CREATE_LINK ${PLANAR_KAHYPAR_SHARED_RESOURCES_DIR} ${CMAKE_CURRENT_BINARY_DIR}/external_tools/kahypar-shared-resources SYMBOLIC)
+endif()
+if(NOT EXISTS ${CMAKE_CURRENT_BINARY_DIR}/external_tools/WHFC)
+  file(CREATE_LINK ${PLANAR_WHFC_DIR} ${CMAKE_CURRENT_BINARY_DIR}/external_tools/WHFC SYMBOLIC)
+endif()
 target_include_directories(MtKaHyPar-Include INTERFACE
                            ${CMAKE_CURRENT_BINARY_DIR}/external_tools/kahypar-shared-resources
                            ${CMAKE_CURRENT_BINARY_DIR}/external_tools)
