#!/usr/bin/env bash
set -euo pipefail

WRAPPER_DIR="$(cd "$(dirname "$0")" && pwd)"
EVAL_DIR="$(cd "$WRAPPER_DIR/.." && pwd)"
REAL_PLANAR_AGENT="$(<"$EVAL_DIR/real-planar-agent")"
OBSERVED_DIR="$EVAL_DIR/observed"
RECORD_SCRIPT="$EVAL_DIR/record_observed.py"
LOCK_DIR="$EVAL_DIR/.observed-seq.lock"
COUNTER_FILE="$EVAL_DIR/.observed-seq"
STALE_LOCK_SECONDS=5
mkdir -p "$OBSERVED_DIR"

STDOUT_FILE="$(mktemp "${TMPDIR:-/tmp}/planar-eval-agent-stdout.XXXXXX")"
STDERR_FILE="$(mktemp "${TMPDIR:-/tmp}/planar-eval-agent-stderr.XXXXXX")"
LOCK_OWNED=0

# shellcheck disable=SC2329 # invoked through the EXIT trap
cleanup() {
  rm -f "$STDOUT_FILE" "$STDERR_FILE"
  # C1: a lane killed WHILE it holds alloc_seq's lock (between mkdir and
  # rmdir) must not leave every later wrapper invocation spinning forever.
  # This trap catches everything a signal handler can catch (SIGTERM and
  # friends); the stale-age reclaim inside alloc_seq's wait loop below is
  # the backstop for SIGKILL, which no trap can observe.
  if [ "$LOCK_OWNED" -eq 1 ]; then
    rmdir "$LOCK_DIR" 2>/dev/null || true
  fi
}
trap cleanup EXIT

lock_age_seconds() {
  local mtime now
  mtime="$(stat -f '%m' "$LOCK_DIR" 2>/dev/null || stat -c '%Y' "$LOCK_DIR" 2>/dev/null || echo "")"
  if [ -z "$mtime" ]; then
    printf '0'
    return
  fi
  now="$(date +%s)"
  printf '%s' "$((now - mtime))"
}

# Allocate a monotonically increasing sequence number so the grader can
# break ties between records that share a timestamp, and set it in $SEQ
# directly (NOT via `$(...)`: a command substitution runs in a forked
# subshell, and LOCK_OWNED set there would be invisible to this script's
# own EXIT trap -- the one case C1 exists to cover). `mkdir` is atomic on
# a POSIX filesystem, so this spinlock is safe across up to sixteen
# concurrent wrapper lanes without depending on a separate locking
# utility (flock is not universally available on the platforms this
# harness targets).
SEQ=""
alloc_seq() {
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    if [ -d "$LOCK_DIR" ] && [ "$(lock_age_seconds)" -gt "$STALE_LOCK_SECONDS" ]; then
      # Stale-lock reclaim: the owner is gone (killed between mkdir and
      # rmdir, or SIGKILLed so its own EXIT trap never ran) and left the
      # directory behind. Reclaim rather than spin forever.
      rmdir "$LOCK_DIR" 2>/dev/null || true
      continue
    fi
    sleep 0.01
  done
  LOCK_OWNED=1
  local n
  n="$(cat "$COUNTER_FILE" 2>/dev/null || printf '0')"
  printf '%s' "$((n + 1))" >"$COUNTER_FILE"
  rmdir "$LOCK_DIR"
  LOCK_OWNED=0
  SEQ="$n"
}
alloc_seq

# Subsecond precision matters here: the grader merges this wrapper's
# records with the specialist fixtures' own boundary-event timestamps
# (also python3 time.time()) by (ts, seq), and BSD `date` has no portable
# subsecond format, so whole-second `date +%s` can misorder a call against
# a same-second boundary event.
#
# NOTE (C9): this is the one place recording is fail-CLOSED, not
# fail-open. `set -euo pipefail` is still in effect and this command
# substitution is unguarded (no surrounding `set +e`), so a MISSING
# python3 makes this line itself abort the whole wrapper at exit 127 --
# before the real binary is ever invoked and before $RC exists to
# forward. That is a harder failure than the fail-open recording path
# below (python3 present but record_observed.py itself erroring), which
# always still forwards the real binary's exit code and writes the
# `.record-failed` sentinel instead of aborting.
TS="$(python3 -c 'import time; print(f"{time.time():.6f}")')"

JSON_FLAG=0
for arg in "$@"; do
  if [ "$arg" = "--json" ]; then
    JSON_FLAG=1
    break
  fi
done

set +e
"$REAL_PLANAR_AGENT" "$@" >"$STDOUT_FILE" 2>"$STDERR_FILE"
RC=$?
set -e
cat "$STDOUT_FILE"
cat "$STDERR_FILE" >&2

# Record every invocation -- including heartbeats and a failed terminal
# verb -- as its own JSON document. Recording failure never masks the
# real exit code: the wrapper's contract is to forward $RC unchanged.
set +e
python3 "$RECORD_SCRIPT" "$OBSERVED_DIR" "$SEQ" "$TS" "$RC" "$JSON_FLAG" \
  "$STDOUT_FILE" "$STDERR_FILE" -- "$@"
RECORD_RC=$?
set -e
if [ "$RECORD_RC" -ne 0 ]; then
  # C2: recording is fail-OPEN by design from HERE on (a dropped record
  # must never mask $RC) -- this is reached only once python3 was
  # available to run record_observed.py at all; see the C9 note at the
  # $TS line above for the one path (python3 itself missing) that fails
  # CLOSED instead. A silently dropped record is indistinguishable from a
  # partial bypass unless something signals it. Write a sentinel the
  # grader treats as a failed run (`assert_no_recording_failures`) -- a
  # plain-text append, not JSON, because this is a last-resort diagnostic
  # path where the primary encoder (record_observed.py) has already
  # failed once.
  echo "planar-agent wrapper: failed to record observed event (exit $RECORD_RC)" >&2
  mkdir -p "$OBSERVED_DIR"
  printf 'seq=%s ts=%s exit=%s record_rc=%s argv=%s\n' \
    "$SEQ" "$TS" "$RC" "$RECORD_RC" "$*" >>"$OBSERVED_DIR/.record-failed"
fi

exit "$RC"
