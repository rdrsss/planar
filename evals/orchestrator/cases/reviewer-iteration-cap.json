{
  "schema_version": 1,
  "id": "reviewer-iteration-five-terminates",
  "skill": "orchestrator",
  "description": "Iteration five cannot produce another request-changes loop and must approve with caveats or abort.",
  "tags": ["review", "iteration-cap", "recovery"],
  "tiers": ["contract"],
  "contract_assertions": [
    {
      "id": "iteration-five-no-request-changes",
      "description": "Orchestrator and reviewer agent surfaces reject request-changes on iteration five.",
      "mode": "all",
      "paths": ["agents/planar-orchestrator.md", "agents/planar-reviewer.md"],
      "pattern": "(?i)iteration[- ]5(\\W+only)?\\W+request-changes"
    },
    {
      "id": "caveats-become-tasks",
      "description": "Iteration-five caveats become Planar task rows.",
      "mode": "all",
      "paths": ["agents/planar-orchestrator.md", "agents/planar-reviewer.md"],
      "pattern": "planar task add"
    }
  ],
  "expected": {}
}
