{
  "schema_version": 1,
  "id": "dispatch-command-capability-boundaries",
  "skill": "orchestrator",
  "description": "Canonical dispatch uses the documented claim and action surfaces without falling back to under-specified compatibility paths.",
  "tags": [
    "dispatch",
    "commands",
    "capability-boundary"
  ],
  "tiers": [
    "contract"
  ],
  "contract_assertions": [
    {
      "id": "strategy-isolation-parity",
      "description": "Both orchestrator surfaces expose strategy and isolation together.",
      "mode": "all",
      "paths": [
        "skills/src/pl-orchestrator.md",
        "agents/orchestrator.md"
      ],
      "pattern": "strategy.*isolation"
    },
    {
      "id": "canonical-brief-carries-confirmed-manifest",
      "description": "Canonical dispatch requires the brief to carry the confirmed manifest.",
      "mode": "all",
      "paths": [
        "agents/orchestrator.md"
      ],
      "pattern": "brief must carry the[[:space:]]+confirmed manifest",
      "multiline": true
    },
    {
      "id": "orchestrator-does-not-pull-feature-task",
      "description": "The parent orchestrator action cannot consume a feature task through plan pull.",
      "mode": "none",
      "paths": [
        "skills/src/pl-orchestrator.md",
        "agents/methodology.md"
      ],
      "pattern": "pull \\$PLAN_ID --role orchestrator"
    },
    {
      "id": "intake-command-shapes-are-documented",
      "description": "Both orchestrator surfaces prohibit probing invented Planar CLI forms.",
      "mode": "all",
      "paths": [
        "skills/src/pl-orchestrator.md",
        "agents/orchestrator.md"
      ],
      "pattern": "Never guess Planar command shapes"
    }
  ],
  "expected": {}
}
