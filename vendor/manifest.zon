.{
    // Declarative manifest for vendored third-party sources. The `vendor_sync`
    // tool reads this file and writes a matching VENDOR.toml into each
    // `vendor/<name>/` directory after a successful sync. `build.zig` performs
    // a fail-fast check at configure time: if `vendor/<name>/VENDOR.toml`
    // does not match the entry below, the build aborts with a message
    // pointing the operator at `zig build vendor-sync`.
    //
    // To bump a dep:
    //   1. Update `version`, `url`, `sha256`, and `strip_prefix` here.
    //   2. Run `zig build vendor-sync`.
    //   3. Commit the manifest + the regenerated files under `vendor/<name>/`.
    //
    // To add a new dep: add another entry to `.deps`. Supported archive types:
    //   - .zip    (zig fetch strips the single top-level directory; use strip_prefix = "")
    //   - .tar_gz (zig fetch also strips the single top-level directory; use strip_prefix = "")
    //
    // strip_prefix semantics (decision 364):
    //   `strip_prefix` is the path **within the zig-normalised cached tree** after
    //   the `<content-hash>/` prefix that zig fetch prepends.  Zig fetch strips
    //   the single top-level directory from BOTH zip and tar.gz archives during
    //   normalisation, so both archive types use `strip_prefix = ""` unless you
    //   want to import from a specific subdirectory of the normalised tree.
    .deps = .{
        .{
            .name = "sqlite",
            .version = "3.50.2",
            .url = "https://sqlite.org/2025/sqlite-amalgamation-3500200.zip",
            .sha256 = "387991de2834b5da2894119ff4173a9ea0779ea55ebcf53d9a40b24d1dc2484e",
            .archive = .zip,
            // zig fetch strips the single top-level dir ("sqlite-amalgamation-3500200/")
            // from zip archives, so the normalised tree has files at root level.
            .strip_prefix = "",
            .keep = .{ "sqlite3.c", "sqlite3.h", "sqlite3ext.h" },
        },
    },
}
