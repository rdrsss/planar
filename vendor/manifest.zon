.{
    // RULE: every vendored third-party dependency MUST be sourced from a pinned
    // release archive (url + sha256) listed here — never a git checkout or
    // submodule. The only sanctioned exception is a dep with no published
    // archive, which must be documented explicitly at its call site. See
    // CLAUDE.md § Operating Rules ("Vendoring rule").
    //
    // Declarative manifest for vendored third-party sources. The `vendor_sync`
    // tool reads this file and writes a matching VENDOR.toml into each
    // `vendor/<name>/` directory after a successful sync. `build.zig` performs
    // a fail-fast check at configure time: if `vendor/<name>/VENDOR.toml`
    // does not match the entry below, the build aborts with a message
    // pointing the operator at `zig build vendor-sync`.
    //
    // To bump a dep:
    //   1. Update `version`, `url`, `sha256`, and `strip_prefix` here.
    //   2. Run `zig build vendor-sync`.
    //   3. Commit the manifest + the regenerated files under `vendor/<name>/`.
    //
    // To add a new dep: add another entry to `.deps`. Supported archive types:
    //   - .zip    (zig fetch strips the single top-level directory; use strip_prefix = "")
    //   - .tar_gz (zig fetch also strips the single top-level directory; use strip_prefix = "")
    //
    // strip_prefix semantics (decision 364):
    //   `strip_prefix` is the path **within the zig-normalised cached tree** after
    //   the `<content-hash>/` prefix that zig fetch prepends.  Zig fetch strips
    //   the single top-level directory from BOTH zip and tar.gz archives during
    //   normalisation, so both archive types use `strip_prefix = ""` unless you
    //   want to import from a specific subdirectory of the normalised tree.
    .deps = .{
        .{
            .name = "sqlite",
            .version = "3.50.2",
            .url = "https://sqlite.org/2025/sqlite-amalgamation-3500200.zip",
            .sha256 = "387991de2834b5da2894119ff4173a9ea0779ea55ebcf53d9a40b24d1dc2484e",
            .archive = .zip,
            // zig fetch strips the single top-level dir ("sqlite-amalgamation-3500200/")
            // from zip archives, so the normalised tree has files at root level.
            .strip_prefix = "",
            .keep = .{ "sqlite3.c", "sqlite3.h", "sqlite3ext.h" },
        },
        .{
            .name = "lua",
            .version = "5.5.0",
            .url = "https://www.lua.org/ftp/lua-5.5.0.tar.gz",
            .sha256 = "57ccc32bbbd005cab75bcc52444052535af691789dba2b9016d5c50640d68b3d",
            .archive = .tar_gz,
            // zig fetch strips the single top-level dir from tar archives
            // as well as zip archives during normalisation; the normalised
            // tree has files at root level (e.g. "src/lapi.c").
            .strip_prefix = "",
            // Library sources only — lua.c (interpreter main) and luac.c
            // (compiler main) are excluded; they define their own `main`
            // and must not be compiled into the static library.
            .keep = .{
                "src/lapi.c",
                "src/lapi.h",
                "src/lauxlib.c",
                "src/lauxlib.h",
                "src/lbaselib.c",
                "src/lcode.c",
                "src/lcode.h",
                "src/lcorolib.c",
                "src/lctype.c",
                "src/lctype.h",
                "src/ldblib.c",
                "src/ldebug.c",
                "src/ldebug.h",
                "src/ldo.c",
                "src/ldo.h",
                "src/ldump.c",
                "src/lfunc.c",
                "src/lfunc.h",
                "src/lgc.c",
                "src/lgc.h",
                "src/linit.c",
                "src/liolib.c",
                "src/ljumptab.h",
                "src/llex.c",
                "src/llex.h",
                "src/llimits.h",
                "src/lmathlib.c",
                "src/lmem.c",
                "src/lmem.h",
                "src/loadlib.c",
                "src/lobject.c",
                "src/lobject.h",
                "src/lopcodes.c",
                "src/lopcodes.h",
                "src/lopnames.h",
                "src/loslib.c",
                "src/lparser.c",
                "src/lparser.h",
                "src/lprefix.h",
                "src/lstate.c",
                "src/lstate.h",
                "src/lstring.c",
                "src/lstring.h",
                "src/lstrlib.c",
                "src/ltable.c",
                "src/ltable.h",
                "src/ltablib.c",
                "src/ltm.c",
                "src/ltm.h",
                "src/lua.h",
                "src/lua.hpp",
                "src/luaconf.h",
                "src/lualib.h",
                "src/lundump.c",
                "src/lundump.h",
                "src/lutf8lib.c",
                "src/lvm.c",
                "src/lvm.h",
                "src/lzio.c",
                "src/lzio.h",
            },
        },
        .{
            .name = "tree-sitter",
            .version = "0.25.10",
            // codeload direct URL (no redirect) — vendor_sync's std.http
            // fetch hard-fails on any non-200, so pin the redirect target.
            .url = "https://codeload.github.com/tree-sitter/tree-sitter/tar.gz/refs/tags/v0.25.10",
            .sha256 = "ad5040537537012b16ef6e1210a572b927c7cdc2b99d1ee88d44a7dcdc3ff44c",
            .archive = .tar_gz,
            // zig fetch strips the single top-level dir ("tree-sitter-0.25.10/");
            // the normalised tree has lib/ at root level.
            .strip_prefix = "",
            // The C runtime is a single-TU amalgam: lib/src/lib.c #includes
            // every other lib/src/*.c (alloc, language, lexer, node, parser,
            // query, stack, subtree, tree_cursor, tree, get_changed_ranges,
            // wasm_store). We compile ONLY lib.c, but every #include'd .c and
            // .h must be present. wasm_store.c is fully guarded by
            // TREE_SITTER_FEATURE_WASM (not defined), so no wasmtime dep.
            // Non-source files (LICENSE, README, ICU_SHA, wasm/ stdlib blobs)
            // are not vendored — they are not in the compile chain.
            .keep = .{
                "lib/include/tree_sitter/api.h",
                "lib/src/alloc.c",
                "lib/src/alloc.h",
                "lib/src/array.h",
                "lib/src/atomic.h",
                "lib/src/clock.h",
                "lib/src/error_costs.h",
                "lib/src/get_changed_ranges.c",
                "lib/src/get_changed_ranges.h",
                "lib/src/host.h",
                "lib/src/language.c",
                "lib/src/language.h",
                "lib/src/length.h",
                "lib/src/lexer.c",
                "lib/src/lexer.h",
                "lib/src/lib.c",
                "lib/src/node.c",
                "lib/src/parser.c",
                "lib/src/parser.h",
                "lib/src/point.h",
                "lib/src/portable/endian.h",
                "lib/src/query.c",
                "lib/src/reduce_action.h",
                "lib/src/reusable_node.h",
                "lib/src/stack.c",
                "lib/src/stack.h",
                "lib/src/subtree.c",
                "lib/src/subtree.h",
                "lib/src/tree_cursor.c",
                "lib/src/tree_cursor.h",
                "lib/src/tree.c",
                "lib/src/tree.h",
                "lib/src/ts_assert.h",
                "lib/src/unicode.h",
                "lib/src/unicode/ptypes.h",
                "lib/src/unicode/umachine.h",
                "lib/src/unicode/urename.h",
                "lib/src/unicode/utf.h",
                "lib/src/unicode/utf16.h",
                "lib/src/unicode/utf8.h",
                "lib/src/wasm_store.c",
                "lib/src/wasm_store.h",
            },
        },
        .{
            .name = "tree-sitter-zig",
            .version = "1.1.2",
            // codeload direct URL (no redirect). Maintained Zig grammar from
            // the tree-sitter-grammars org. v1.1.2 has NO external scanner
            // (EXTERNAL_TOKEN_COUNT 0), so only parser.c + tree_sitter/parser.h
            // are needed; no scanner.c.
            .url = "https://codeload.github.com/tree-sitter-grammars/tree-sitter-zig/tar.gz/refs/tags/v1.1.2",
            .sha256 = "612d67059faa90ec7691e5d786d70d8f7c2c8b15b83de901b9b801122ad4cf25",
            .archive = .tar_gz,
            // zig fetch strips the single top-level dir ("tree-sitter-zig-1.1.2/");
            // the normalised tree has src/ at root level.
            .strip_prefix = "",
            .keep = .{
                "src/parser.c",
                "src/tree_sitter/parser.h",
            },
        },
        .{
            .name = "etcli",
            .version = "0.2.0",
            // Direct codeload URL. The friendlier
            // github.com/rdrsss/etcli/archive/refs/tags/v0.2.0.tar.gz form
            // 302-redirects to this; vendor_sync's std.http fetch does not
            // follow redirects (it hard-fails on any non-200), so pin the
            // redirect target directly. Identical bytes, identical sha256.
            .url = "https://codeload.github.com/rdrsss/etcli/tar.gz/refs/tags/v0.2.0",
            .sha256 = "56cbe09ecd069d0ccb89dc5e514c37f0fffb5fd8e588d94c2dd5bd4579e545d4",
            .archive = .tar_gz,
            // zig fetch strips the single top-level dir ("etcli-0.2.0/"); the
            // normalised tree has build.zig + src/cli/ at root. Library only —
            // examples/integration_tests/docs/scripts/CHANGELOG are dropped, as
            // Planar only consumes the `cli` module via a path dependency.
            .strip_prefix = "",
            .keep = .{
                "build.zig",
                "build.zig.zon",
                "LICENSE",
                "README.md",
                "src/cli/app.zig",
                "src/cli/artifacts.zig",
                "src/cli/cmd.zig",
                "src/cli/completion.zig",
                "src/cli/doc.zig",
                "src/cli/duration.zig",
                "src/cli/error.zig",
                "src/cli/flag.zig",
                "src/cli/help.zig",
                "src/cli/man.zig",
                "src/cli/meta.zig",
                "src/cli/parser.zig",
                "src/cli/platform/root.zig",
                "src/cli/root.zig",
                "src/cli/schema.zig",
                "src/cli/validate.zig",
            },
        },
    },
}
