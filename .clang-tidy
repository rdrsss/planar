# Planar clang-tidy configuration — adopted from tabula (D16), corrected at
# task 6438. Identifier naming only, for now — lower_case identifiers, `_`
# private/protected member prefix, and tabula's deliberate exception kept:
# template parameters are CamelCase, the one non-lower_case identifier kind,
# kept as the visual signal distinguishing a template parameter from a
# concrete type. Use the pinned LLVM's clang-tidy (docs/toolchain-parity.md).
#
# Task 6438 removed tabula's `_` PublicMemberSuffix rule: it never matched
# this codebase's actual convention (CLAUDE.md § C++ Style: plain snake_case
# throughout, e.g. `struct parsed_args`) and was firing on 2925 of 3030
# measured warnings (96.5%) — a config/codebase disagreement inherited
# wholesale from tabula rather than a real defect. Public members now fall
# back to VariableCase (lower_case), matching what the codebase already
# does almost everywhere (see e.g. src/lib/engine/identity/scope.cppm).
---
Checks: >
  -*,
  readability-identifier-naming
CheckOptions:
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: '_'
  - key: readability-identifier-naming.ProtectedMemberPrefix
    value: '_'
  - key: readability-identifier-naming.ClassCase
    value: lower_case
  - key: readability-identifier-naming.StructCase
    value: lower_case
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.MethodCase
    value: lower_case
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.EnumCase
    value: lower_case
  - key: readability-identifier-naming.EnumConstantCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  # Template parameters are PascalCase (D16) — deliberately the one
  # un-lower_case identifier kind, so it stays the sole signal that
  # distinguishes a template parameter from a concrete type at point of use.
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase
  - key: readability-identifier-naming.TypeTemplateParameterCase
    value: CamelCase
...
